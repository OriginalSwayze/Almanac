{
    "name": "Almanac",
    "author": "OriginalSwayze",
    "description": "A sky that follows your real clock: dawn, noon, dusk and night tint the whole client; the sun and moon cross the window; stars, clouds, rain or seasonal snow. Laid out like a magazine page with a masthead dateline, an icon rail and vertical navigation.",
    "version": "1.0.0",
    "tags": [
        "Weather",
        "Time of day",
        "Animated",
        "Elegant",
        "Glass"
    ],
    "header_image": "https://raw.githubusercontent.com/OriginalSwayze/Almanac/main/media/library.gif",
    "splash_image": "https://raw.githubusercontent.com/OriginalSwayze/Almanac/main/media/gamepage.png",
    "github": {
        "owner": "OriginalSwayze",
        "repo_name": "Almanac"
    },
    "Steam-WebKit": "webkit.css",
    "Conditions": {
        "Weather": {
            "description": "Seasonal: snow from December to February, clear otherwise. Or pick one.",
            "tab": "Look",
            "default": "Seasonal",
            "values": {
                "Seasonal": {},
                "Clear": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/weather-clear.css"
                    }
                },
                "Rain": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/weather-rain.css"
                    }
                },
                "Snow": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/weather-snow.css"
                    }
                }
            }
        },
        "Sky": {
            "description": "Follow the clock, or keep it always day or always night.",
            "tab": "Look",
            "default": "Follow the clock",
            "values": {
                "Follow the clock": {},
                "Always day": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/force-day.css"
                    }
                },
                "Always night": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/force-night.css"
                    }
                }
            }
        },
        "Clouds": {
            "description": "Soft clouds drifting across the sky.",
            "tab": "Look",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/clouds-off.css"
                    }
                }
            }
        },
        "Corner radius": {
            "description": "How round the panels are.",
            "tab": "Look",
            "default": 22,
            "slider": {
                "cssVariable": "--mr-setting-radius",
                "min": 0,
                "max": 40,
                "step": 2,
                "unit": "px"
            }
        },
        "Glass tint": {
            "description": "How much the sky shows through the panels.",
            "tab": "Look",
            "default": 55,
            "slider": {
                "cssVariable": "--mr-setting-tint",
                "min": 20,
                "max": 95,
                "step": 5,
                "unit": "%"
            }
        },
        "Game list density": {
            "description": "Row size in the game list.",
            "tab": "Layout",
            "default": "Comfortable",
            "values": {
                "Comfortable": {},
                "Compact": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/list-compact.css"
                    }
                }
            }
        },
        "What's New shelf": {
            "description": "The What's New carousel on the library home.",
            "tab": "Layout",
            "default": "Show",
            "values": {
                "Show": {},
                "Hide": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/hide-whats-new.css"
                    }
                }
            }
        },
        "Dock labels": {
            "description": "Labels on the dock buttons: on hover, or always.",
            "tab": "Layout",
            "default": "On hover",
            "values": {
                "On hover": {},
                "Always": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/dock-labels.css"
                    }
                }
            }
        },
        "Readout": {
            "description": "The masthead dateline: day, date, time, part of the day and weather.",
            "tab": "Layout",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/hud-off.css"
                    }
                }
            }
        },
        "Startup screen": {
            "description": "A greeting for the time of day when Steam opens.",
            "tab": "Motion",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/boot-off.css"
                    }
                }
            }
        },
        "Motion": {
            "description": "Full: everything. Calm: hovers only, the backdrop stands still. Still: no theme motion.",
            "tab": "Motion",
            "default": "Full",
            "values": {
                "Full": {},
                "Calm": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/motion-calm.css"
                    }
                },
                "Still": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/motion-still.css"
                    }
                }
            }
        },
        "Cover hover": {
            "description": "Library covers under the cursor: Tilt, Lift or Off.",
            "tab": "Motion",
            "default": "Tilt",
            "values": {
                "Tilt": {},
                "Lift": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/covers-lift.css"
                    }
                },
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/covers-off.css"
                    }
                }
            }
        },
        "Cursor light": {
            "description": "A soft light that follows the cursor across panels.",
            "tab": "Motion",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/cursor-light-off.css"
                    }
                }
            }
        },
        "Privacy": {
            "description": "Blur your account name and wallet until hovered.",
            "tab": "Extras",
            "default": "Off",
            "values": {
                "Off": {},
                "Blur": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/privacy.css"
                    }
                }
            }
        },
        "Contrast": {
            "description": "High: solid panels and brighter secondary text.",
            "tab": "Accessibility",
            "default": "Normal",
            "values": {
                "Normal": {},
                "High": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/contrast-high.css"
                    }
                }
            }
        },
        "Focus rings": {
            "description": "Strong: a thick, high-visibility outline on whatever has keyboard or controller focus.",
            "tab": "Accessibility",
            "default": "Standard",
            "values": {
                "Standard": {},
                "Strong": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/focus-strong.css"
                    }
                }
            }
        },
        "Text size": {
            "description": "Large: bigger game list and body text.",
            "tab": "Accessibility",
            "default": "Normal",
            "values": {
                "Normal": {},
                "Large": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/text-large.css"
                    }
                }
            }
        }
    },
    "Patches": [
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "main.css",
            "TargetJs": "js/main.js"
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".FullModalOverlay",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "friends.css"
        },
        {
            "MatchRegexString": ".ContextMenuPopup",
            "TargetCss": "popup.css"
        },
        {
            "MatchRegexString": ".DesktopToastContainer",
            "TargetCss": "toast.css"
        },
        {
            "MatchRegexString": "^Sign in to Steam$",
            "TargetCss": "login.css"
        }
    ]
}
